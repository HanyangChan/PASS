{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:all)",
      "Bash(npm run check:scope)",
      "Bash(node --test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./app/.env)",
      "Read(./app/.env.*)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-scope.mjs\"" }
        ]
      }
    ]
  }
}

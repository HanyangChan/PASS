# 값은 넣지 말고 이름만 둔다. 실제 값은 .env (커밋 금지)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://llm.ai.hy.miwork.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_REASONING=off
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
PIPELINE_DB_PATH=.data/pipeline.sqlite
PORT=8787
# 대화 이해 LLM 타임아웃(ms), 기본 8000
DIALOGUE_LLM_TIMEOUT_MS=8000
# GEMINI_MODEL은 -latest 별칭 대신 버전 이름을 쓴다 (예: gemini-3.5-flash-lite)

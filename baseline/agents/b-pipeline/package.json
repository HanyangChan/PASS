{
  "name": "pass-b-pipeline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:all": "npm --prefix ../.. test",
    "check:scope": "node scripts/check-scope.mjs",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "index:dry": "node --env-file-if-exists=.env indexer/agent.mjs --dry-run --limit=10",
    "demo": "npm --prefix ../.. run demo:agent -- b-pipeline",
    "latency": "node scripts/latency.mjs",
    "llm:smoke": "node --env-file=.env scripts/llm-smoke.mjs"
  }
}

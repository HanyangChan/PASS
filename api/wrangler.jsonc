{
  "name": "pass-recommendation-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  // Web catalog photos (committed in supabase/seed/images-kr/). The Worker runs first and serves them
  // only at /catalog-images/<file> through the ASSETS binding (api/worker.mjs).
  "assets": {
    "directory": "../supabase/seed/images-kr",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CHAT_AGENT": "a-router",
    "SUPABASE_URL": "https://zenmtrokvnwsekidcniy.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_XlhsG0VhBso-EFxXF8ZfFg_lR3DBUok",
    "APP_ORIGINS": "https://temporary-prompt-sable-s15js3l.vercel.app",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "LLM_PROVIDER": "openai-compatible",
    "LLM_BASE_URL": "https://llm.ai.hy.miwork.ai",
    "LLM_MODEL": "gpt-5.6-luna",
    "LLM_REASONING_ENABLED": "false",
    "LLM_CHAT_PATH": "chat/completions",
    "LLM_RESPONSE_FORMAT": "json_object",
    "A_ROUTER_LLM_MODE": "single"
  },
  "ratelimits": [
    {
      "name": "IP_LIMITER",
      "namespace_id": "73571001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "USER_LIMITER",
      "namespace_id": "73571002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "placement": {
    "region": "gcp:us-east4"
  }
}

# Local development only. Copy to .dev.vars and never commit real keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGINS=http://127.0.0.1:8766
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# a-router: rules first, optional configured LLM fallback. legacy: original prototype path.
CHAT_AGENT=a-router
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://llm.ai.hy.miwork.ai
LLM_MODEL=deepseek-v4-flash
LLM_CHAT_PATH=chat/completions
LLM_RESPONSE_FORMAT=json_object
LLM_API_KEY=

# single (default) or supervised multi-agent interpretation
A_ROUTER_LLM_MODE=single
